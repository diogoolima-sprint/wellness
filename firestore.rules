rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // Integration status is written only by Cloud Functions. The plan is normally
      // written by generatePlan, but the app may store a rule-based plan when offline.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['integrations']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['integrations']);
      allow delete: if false;

      // Workouts done inside the app.
      match /workouts/{workoutId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      // Activities imported from Strava (server-written).
      match /activities/{activityId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // OAuth tokens, OAuth state and athlete→user mapping: server only.
    match /stravaTokens/{doc} { allow read, write: if false; }
    match /stravaOAuthStates/{doc} { allow read, write: if false; }
    match /stravaAthletes/{doc} { allow read, write: if false; }
    match /stravaEvents/{doc} { allow read, write: if false; }
  }
}
