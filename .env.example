# Firebase web config (Console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region where the Cloud Functions are deployed
VITE_FUNCTIONS_REGION=southamerica-east1
# Show "Continuar com Apple" (requires an Apple Developer account; see README)
VITE_ENABLE_APPLE=false
# Local development with the Firebase emulators (use a demo-* project id)
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1
